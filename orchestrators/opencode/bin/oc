#!/usr/bin/env bash
# oc — OpenCode launcher for forge
#
# Points OpenCode at the framework's opencode.jsonc config and the
# .opencode/ wrapper dir via OPENCODE_CONFIG / OPENCODE_CONFIG_DIR.
#
# FRAMEWORK_DIR resolution priority (analog to cc):
#   1. env var (override, e.g. testing alternate checkout)
#   2. autodetect from $0 location: the checkout this file lives in. The
#      installed ~/.local/bin/oc is a fixed stub that execs this file in the
#      checkout (scripts/forge_install.py), so a `git pull` there reaches it
#
# Usage:
#   oc                # OpenCode with framework config
#   oc <opencode-args>

set -euo pipefail

if [ -z "${FRAMEWORK_DIR:-}" ]; then
  FRAMEWORK_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)"
fi
export FRAMEWORK_DIR
# Bring the installed entries up to the checkout's commit before the start
# (`git pull` is the update), as cc does; its result never stops a start.
python3 -B "$FRAMEWORK_DIR/scripts/forge_install.py" --refresh < /dev/null > /dev/null || true
VALIDATION_ARGS=()
if [ "${1:-}" = "--forge-validation-operation" ]; then
  if [ -z "${2:-}" ]; then
    echo "validation launch requires an exact pending operation ID" >&2
    exit 2
  fi
  VALIDATION_ARGS=(--validation-operation "$2")
  shift 2
fi
if ! python3 -B "$FRAMEWORK_DIR/scripts/forge_install.py" --maintenance status --require-ready "${VALIDATION_ARGS[@]}"; then
  echo "oc: STOP — coordinated installation is not validated; inspect maintenance status." >&2
  exit 1
fi

OC_CONFIG_DIR="$FRAMEWORK_DIR/orchestrators/opencode/.opencode"
OC_CONFIG="$HOME/.config/forge/opencode.jsonc"

# Verify config exists. If not, name the machine install for OpenCode.
if [ ! -f "$OC_CONFIG" ]; then
  echo "oc: ERROR — $OC_CONFIG not found." >&2
  echo "    Run: python3 $FRAMEWORK_DIR/scripts/forge_install.py --profile full-ai-integration --host opencode" >&2
  exit 1
fi

export OPENCODE_CONFIG_DIR="$OC_CONFIG_DIR"
export OPENCODE_CONFIG="$OC_CONFIG"

if ! command -v opencode &>/dev/null; then
  echo "oc: WARNUNG — 'opencode' nicht im PATH." >&2
fi

exec opencode "$@"
